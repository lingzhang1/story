# C3B device test media (local-first; originals stay on device, never committed)
evals/story_director/dir_gear_prep/
evals/story_director/dir_home_doorway/
evals/story_director/dir_tmb_pretrip_home/

# Private eval raw + DERIVED media (friends/faces/homes/travel footage stays LOCAL ONLY).
# Directory-level ignore (fail-safe by LOCATION, not by extension): the entire tree —
# private_local/videos/ (raw clips, incl. the C4 corpus), private_local/frames/ and
# private_local/thumbs/ (DERIVED sampled frames/thumbnails) — is never committed.
# Committed fixture metadata/expectations live under evals/shot_validation/ and reference
# this media by path (see evals/shot_validation/media-map.json); media is never duplicated.
evals/assets/private_local/

# Raw video media anywhere under evals/assets/ stays LOCAL ONLY (friends/faces/
# homes/travel footage). Case-insensitive HFS matches .mov/.MOV etc.; NOTES.md,
# metadata.json and other text fixtures under the same dirs ARE still committed.
evals/assets/**/*.mov
evals/assets/**/*.MOV
evals/assets/**/*.mp4
evals/assets/**/*.MP4
evals/assets/**/*.m4v
evals/assets/**/*.M4V
evals/assets/**/*.mkv
evals/assets/**/*.avi
evals/assets/**/*.hevc
evals/assets/**/*.HEVC

# Exported frames / sampled stills / thumbnails anywhere under evals/assets/
# stay LOCAL ONLY too — a frame of personal footage is as private as the clip.
# Text fixtures (.md, .json) and vector diagrams (.svg) under the same dirs
# remain committable; only raster image exports are ignored here.
evals/assets/**/*.jpg
evals/assets/**/*.JPG
evals/assets/**/*.jpeg
evals/assets/**/*.JPEG
evals/assets/**/*.png
evals/assets/**/*.PNG
evals/assets/**/*.heic
evals/assets/**/*.HEIC
evals/assets/**/*.heif
evals/assets/**/*.HEIF
evals/assets/**/*.webp
evals/assets/**/*.WEBP
evals/assets/**/*.gif
evals/assets/**/*.GIF
evals/assets/**/*.bmp
evals/assets/**/*.tiff
evals/assets/**/*.tif
scripts/.yotale_beta_allowlist
