// Development.xcconfig — TestFlight Option A beta-archive safety gate.
//
// Baked environment for DEVELOPMENT builds. These feed the Info.plist $(STORY_*) substitutions that
// StoryEnvironment reads. In a DEBUG build StoryEnvironment ignores these and keeps the scheme-env override
// chain; they matter for a RELEASE build labelled development (which StoryEnvironment refuses to ship — a
// release build must be a real non-dev env). Values are NON-SECRET identifiers, never credentials.
//
// xcconfig note: `//` starts a comment, so the redirect URI is assembled from a SLASH helper to emit
// `story://auth` without truncation.

SLASH = /

STORY_BUILD_ENV = development
STORY_ENV_API_BASE_URL = https://ydmju5wdps.us-east-1.awsapprunner.com
STORY_ENV_COGNITO_REGION = us-east-1
STORY_ENV_USER_POOL_ID = us-east-1_AzfHOEdA5
STORY_ENV_APP_CLIENT_ID = 5rnvp7oq6d7crbt01ldpe89tkh
STORY_ENV_DOMAIN_PREFIX = story-development-auth
STORY_ENV_REDIRECT_URI = story:$(SLASH)$(SLASH)auth
