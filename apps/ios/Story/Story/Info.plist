<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- P0 Editorial Pipeline v2: build provenance. Value comes from the GIT_COMMIT_SHA build setting
         (defaulted to "unknown" in the project so a valid build NEVER fails for missing git metadata). A
         Run Script build phase may populate the real short SHA at build time (see the P0 report). Read at
         runtime by BuildProvenance.current(); "unknown" when not populated. -->
    <key>GitCommitSHA</key>
    <string>$(GIT_COMMIT_SHA)</string>
    <!-- TestFlight Option A beta-archive safety gate: the resolved environment is BAKED here at build time
         via build-setting substitution from the selected xcconfig (Development.xcconfig / Beta.xcconfig).
         StoryEnvironment reads ONLY these in a RELEASE/Archive build (ignoring ProcessInfo env + persisted
         UserDefaults) and FAILS CLOSED if StoryBuildEnv=beta but any value is missing/mismatched. A DEBUG
         build ignores these and keeps the scheme-env override chain. STORY_BUILD_ENV defaults to
         "development" in the project so an un-wired build is a dev build, never a half-configured beta. -->
    <key>StoryBuildEnv</key>
    <string>$(STORY_BUILD_ENV)</string>
    <key>StoryEnvApiBaseURL</key>
    <string>$(STORY_ENV_API_BASE_URL)</string>
    <key>StoryEnvCognitoRegion</key>
    <string>$(STORY_ENV_COGNITO_REGION)</string>
    <key>StoryEnvUserPoolId</key>
    <string>$(STORY_ENV_USER_POOL_ID)</string>
    <key>StoryEnvAppClientId</key>
    <string>$(STORY_ENV_APP_CLIENT_ID)</string>
    <key>StoryEnvDomainPrefix</key>
    <string>$(STORY_ENV_DOMAIN_PREFIX)</string>
    <key>StoryEnvRedirectURI</key>
    <string>$(STORY_ENV_REDIRECT_URI)</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Story can tag the Moments you record with where you captured them, so your travel memories remember the place. Location is optional and never added to the videos you share.</string>
    <key>UIAppFonts</key>
    <array>
        <string>Fraunces.ttf</string>
        <string>Fraunces-Italic.ttf</string>
        <string>DMSans.ttf</string>
        <string>DMSans-Italic.ttf</string>
    </array>
    <!-- P0 Beta Auth Increment 4: custom-scheme redirect for the Cognito OAuth (Sign in with Apple) callback. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dev.story.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>story</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
