<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Story can tag the Moments you record with where you captured them, so your travel memories remember the place. Location is optional and never added to the videos you share.</string>
    <key>UIAppFonts</key>
    <array>
        <string>Fraunces.ttf</string>
        <string>Fraunces-Italic.ttf</string>
        <string>DMSans.ttf</string>
        <string>DMSans-Italic.ttf</string>
    </array>
    <!-- P0 Beta Auth Increment 4: custom-scheme redirect for the Cognito OAuth (Sign in with Apple) callback. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dev.story.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>story</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
