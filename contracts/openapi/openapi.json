{
  "components": {
    "schemas": {
      "AssetDTO": {
        "additionalProperties": false,
        "description": "Wire shape of an Asset.\n\nLOCAL-FIRST: `local_uri` is a device-local reference the client owns.\nThe backend never receives the bytes; this DTO carries the reference\nstring only, never a cloud URL and never the media itself.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "local_uri": {
            "title": "Local Uri",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "local_uri",
          "duration_seconds",
          "source",
          "created_at"
        ],
        "title": "AssetDTO",
        "type": "object"
      },
      "CreateStoryRequest": {
        "additionalProperties": false,
        "description": "POST /v1/stories body.",
        "properties": {
          "raw_text": {
            "description": "User's creative direction",
            "minLength": 1,
            "title": "Raw Text",
            "type": "string"
          },
          "title": {
            "description": "Human-readable Story title",
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "raw_text",
          "title"
        ],
        "title": "CreateStoryRequest",
        "type": "object"
      },
      "CreativeIntentDTO": {
        "additionalProperties": false,
        "description": "Wire shape of a derived CreativeIntent.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "raw_text": {
            "title": "Raw Text",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "theme": {
            "title": "Theme",
            "type": "string"
          },
          "tone": {
            "title": "Tone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "raw_text",
          "theme",
          "tone",
          "summary",
          "created_at"
        ],
        "title": "CreativeIntentDTO",
        "type": "object"
      },
      "GeneratedOutputDTO": {
        "additionalProperties": false,
        "description": "Wire shape of a GeneratedOutput (metadata only \u2014 no media).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "moment_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Moment Ids",
            "type": "array"
          },
          "story_id": {
            "format": "uuid",
            "title": "Story Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "story_id",
          "title",
          "duration_seconds",
          "created_at"
        ],
        "title": "GeneratedOutputDTO",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MomentDTO": {
        "additionalProperties": false,
        "description": "Wire shape of a Moment (embeds its Asset).",
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/AssetDTO"
          },
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Caption"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "story_id": {
            "format": "uuid",
            "title": "Story Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "story_id",
          "asset",
          "source",
          "created_at"
        ],
        "title": "MomentDTO",
        "type": "object"
      },
      "StoryDTO": {
        "additionalProperties": false,
        "description": "Wire shape of a Story aggregate.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "creative_intent": {
            "$ref": "#/components/schemas/CreativeIntentDTO"
          },
          "generated_outputs": {
            "items": {
              "$ref": "#/components/schemas/GeneratedOutputDTO"
            },
            "title": "Generated Outputs",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "moments": {
            "items": {
              "$ref": "#/components/schemas/MomentDTO"
            },
            "title": "Moments",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/StoryStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "creative_intent",
          "created_at",
          "updated_at"
        ],
        "title": "StoryDTO",
        "type": "object"
      },
      "StoryStatus": {
        "description": "Wire copy of the domain status enum (network-facing).",
        "enum": [
          "active",
          "completed"
        ],
        "title": "StoryStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Story API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/stories": {
      "post": {
        "description": "Derive a CreativeIntent from raw_text and create a Story.",
        "operationId": "create_story_v1_stories_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoryDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Story"
      }
    },
    "/v1/stories/{story_id}/outputs": {
      "post": {
        "description": "Create a mock GeneratedOutput for a Story.\n\nINVARIANT: Create != Complete. This MUST NOT change story.status.",
        "operationId": "create_output_v1_stories__story_id__outputs_post",
        "parameters": [
          {
            "in": "path",
            "name": "story_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Story Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedOutputDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Output"
      }
    }
  }
}
