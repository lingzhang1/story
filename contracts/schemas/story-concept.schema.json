{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A creative idea proposed by the Director Engine (02 \u00a716).\n\n`summary` IS the Story's creative thesis (05-story-director.md \u00a74) \u2014 there\nis deliberately no separate `thesis` field.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "preview_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Asset Id"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "target_narrative_need_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Narrative Need Id"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "summary"
  ],
  "title": "StoryConcept",
  "type": "object"
}
