{
  "$defs": {
    "BeatProgress": {
      "additionalProperties": false,
      "description": "How far one StoryBeat has been fulfilled \u2014 DIRECTOR state, not planning\nand not ValidationResult (05 \u00a77). Categorical, no numeric percentage.\n`supporting_asset_ids` is OPTIONAL (its necessity is an open experiment).",
      "properties": {
        "beat_id": {
          "title": "Beat Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BeatStatus",
          "default": "unfulfilled"
        },
        "supporting_asset_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supporting Asset Ids",
          "type": "array"
        }
      },
      "required": [
        "beat_id"
      ],
      "title": "BeatProgress",
      "type": "object"
    },
    "BeatStatus": {
      "description": "How much a StoryBeat has been fulfilled \u2014 DIRECTOR state, not planning\nand not ValidationResult (05-story-director.md \u00a77). Categorical, no numeric\npercentage.",
      "enum": [
        "unfulfilled",
        "partial",
        "fulfilled"
      ],
      "title": "BeatStatus",
      "type": "string"
    },
    "CaptureEntryPoint": {
      "description": "Where a CaptureSession originated (02 \u00a714).",
      "enum": [
        "create_now",
        "shoot_moment",
        "story_idea"
      ],
      "title": "CaptureEntryPoint",
      "type": "string"
    },
    "CreativeIntentContract": {
      "additionalProperties": false,
      "description": "Normalized, structured representation of what the user wants to create.\n\nFrozen full shape (02 \u00a74, refined by 04-creative-intent.md Milestone C).\nThe Milestone-A code carried a flattened {raw_text, theme, tone, summary};\nmap `raw_text`->`raw_user_description`, `summary`->`summary`, and seed\n`style_tags`/`desired_feeling` from the mock `theme`/`tone` until the real\nresolver populates them (reconciliation \u00a73.1).\n\nDescribes the desired OUTCOME only \u2014 never physical-scene facts, shot\ninstructions, edit decisions, or provider/model metadata (04 \u00a78).",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "creative_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Creative Constraints",
          "type": "array"
        },
        "desired_feeling": {
          "items": {
            "type": "string"
          },
          "title": "Desired Feeling",
          "type": "array"
        },
        "emphasis": {
          "description": "What should receive creative attention (04 \u00a77.5): person/environment/scale/...",
          "items": {
            "type": "string"
          },
          "title": "Emphasis",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "pace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pace"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Broad temporal energy (04 \u00a77.3). Categorical only."
        },
        "raw_user_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw User Description"
        },
        "source_inputs": {
          "items": {
            "$ref": "#/$defs/CreativeIntentSource"
          },
          "title": "Source Inputs",
          "type": "array"
        },
        "style_tags": {
          "items": {
            "type": "string"
          },
          "title": "Style Tags",
          "type": "array"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the Story is broadly about (semantic, not detected objects)",
          "title": "Subject"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "target_duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Duration Seconds"
        },
        "target_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "title": "CreativeIntentContract",
      "type": "object"
    },
    "CreativeIntentSource": {
      "additionalProperties": false,
      "description": "One contributing input to a CreativeIntent.",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "when type=reference_asset",
          "title": "Asset Id"
        },
        "template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "when type=template",
          "title": "Template Id"
        },
        "type": {
          "$ref": "#/$defs/CreativeIntentSourceType"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "text value, when type=text",
          "title": "Value"
        }
      },
      "required": [
        "type"
      ],
      "title": "CreativeIntentSource",
      "type": "object"
    },
    "CreativeIntentSourceType": {
      "enum": [
        "text",
        "template",
        "reference_asset"
      ],
      "title": "CreativeIntentSourceType",
      "type": "string"
    },
    "DirectorActionType": {
      "description": "The Director's next action in the DIRECT decision loop\n(05-story-director.md \u00a77, \u00a720). One strongest recommendation at a time.",
      "enum": [
        "capture_shot",
        "create_now",
        "rescan_scene",
        "retry_shot"
      ],
      "title": "DirectorActionType",
      "type": "string"
    },
    "DirectorDecision": {
      "additionalProperties": false,
      "description": "The Director's single strongest next recommendation (05 \u00a75, \u00a79).\n\nSeparate from StoryPlan: StoryPlan = WHAT material would create the Story;\nDirectorDecision = what the user/system should DO next. Never exposes\nmultiple creative choices to the user by default.",
      "properties": {
        "action": {
          "$ref": "#/$defs/DirectorActionType"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Internal rationale for this decision (not necessarily user-facing).",
          "title": "Reason"
        },
        "shot": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ],
      "title": "DirectorDecision",
      "type": "object"
    },
    "DirectorState": {
      "additionalProperties": false,
      "description": "Mutable DIRECT execution state, owned by the CaptureSession (05 \u00a78).\n\nSeparated from StoryPlan (the intent) so the plan stays a stable record of\nwhat we meant to capture while this tracks what actually happened.",
      "properties": {
        "beat_progress": {
          "items": {
            "$ref": "#/$defs/BeatProgress"
          },
          "title": "Beat Progress",
          "type": "array"
        },
        "current_beat_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Beat Id"
        },
        "last_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectorDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DirectorState",
      "type": "object"
    },
    "OperatorSpace": {
      "description": "Visually apparent room for the camera operator (04-scene-understanding.md \u00a718).\n\nAn observation of visible space \u2014 NOT a safety guarantee. Director still\napplies conservative capture rules regardless of this value.",
      "enum": [
        "very_limited",
        "limited",
        "moderate",
        "open",
        "unknown"
      ],
      "title": "OperatorSpace",
      "type": "string"
    },
    "OutputFormat": {
      "enum": [
        "vertical",
        "square",
        "landscape"
      ],
      "title": "OutputFormat",
      "type": "string"
    },
    "Pace": {
      "description": "Broad temporal energy of the desired output (04-creative-intent.md \u00a77.3).\n\nCategorical, NOT continuous and NOT exact edit timing \u2014 shot rhythm and\ncut points belong to StoryPlan / EditPlan, not CreativeIntent.",
      "enum": [
        "slow",
        "moderate",
        "fast"
      ],
      "title": "Pace",
      "type": "string"
    },
    "SceneSubject": {
      "additionalProperties": false,
      "description": "A subject detected in the scene.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "prominence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectProminence"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Visual prominence (04 \u00a713). Not semantic importance."
        }
      },
      "required": [
        "label"
      ],
      "title": "SceneSubject",
      "type": "object"
    },
    "SceneUnderstandingContract": {
      "additionalProperties": false,
      "description": "What Story understands about the user's current environment.\n\nDescribes WHAT IS THERE \u2014 not the directing decision (02 \u00a715, 04-scene-\nunderstanding.md \u00a73). Opportunities are OBSERVATIONS; the Director decides\nwhat to shoot.",
      "properties": {
        "composition_opportunities": {
          "items": {
            "type": "string"
          },
          "title": "Composition Opportunities",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "environment_tags": {
          "items": {
            "type": "string"
          },
          "title": "Environment Tags",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "lighting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concise lighting description (scalar, 04 \u00a719).",
          "title": "Lighting"
        },
        "motion_opportunities": {
          "items": {
            "type": "string"
          },
          "title": "Motion Opportunities",
          "type": "array"
        },
        "operator_space": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperatorSpace"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Visibly apparent operator room (04 \u00a718). Not a safety guarantee."
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/SceneSubject"
          },
          "title": "Subjects",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "title": "SceneUnderstandingContract",
      "type": "object"
    },
    "ShotContract": {
      "additionalProperties": false,
      "description": "One directed shot. Frozen product name is `Shot` (the element of\nStoryPlan.shots[]); 02 \u00a718 called this ShotPlan \u2014 see reconciliation \u00a74.2.\n\nTwo explicit layers (05-story-director.md \u00a712): `purpose` is the INTERNAL\nsemantic reason the shot exists (what Validation cares about); `instruction`\nis the simple USER-FACING direction. Keep both distinct.",
      "properties": {
        "beat_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The StoryBeat this shot serves (every shot serves a beat).",
          "title": "Beat Id"
        },
        "camera_motion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Motion"
        },
        "example_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example Asset Id"
        },
        "framing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framing"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Internal semantic reason the shot exists (05 \u00a712).",
          "title": "Purpose"
        },
        "subject_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Action"
        },
        "target_duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Duration Seconds"
        }
      },
      "required": [
        "id",
        "order",
        "instruction"
      ],
      "title": "ShotContract",
      "type": "object"
    },
    "StoryBeat": {
      "additionalProperties": false,
      "description": "A creative/narrative purpose the resulting Story needs to express\n(05-story-director.md \u00a71-4). PLANNING object \u2014 minimal, no mutable\nexecution state (fulfillment lives in DirectorState/BeatProgress).\nEvery planned Shot serves a Beat; every Beat serves the StoryConcept.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "id",
        "purpose"
      ],
      "title": "StoryBeat",
      "type": "object"
    },
    "StoryConceptContract": {
      "additionalProperties": false,
      "description": "A creative idea proposed by the Director Engine (02 \u00a716).\n\n`summary` IS the Story's creative thesis (05-story-director.md \u00a74) \u2014 there\nis deliberately no separate `thesis` field.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "preview_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Asset Id"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "target_narrative_need_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Narrative Need Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary"
      ],
      "title": "StoryConceptContract",
      "type": "object"
    },
    "StoryPlanContract": {
      "additionalProperties": false,
      "description": "The directed capture for one concept: WHAT material would create the\nStory. MVP: generally 1-3 shots (02 \u00a717). PLANNING only \u2014 it does NOT own\nexecution progress (that is DirectorState). Every shot's `beat_id` should\nreference a beat in `beats` (05-story-director.md \u00a72).",
      "properties": {
        "beats": {
          "items": {
            "$ref": "#/$defs/StoryBeat"
          },
          "title": "Beats",
          "type": "array"
        },
        "concept_id": {
          "format": "uuid",
          "title": "Concept Id",
          "type": "string"
        },
        "estimated_duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Duration Seconds"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/ShotContract"
          },
          "title": "Shots",
          "type": "array"
        }
      },
      "required": [
        "id",
        "concept_id"
      ],
      "title": "StoryPlanContract",
      "type": "object"
    },
    "SubjectProminence": {
      "description": "How visually prominent a scene subject is (04-scene-understanding.md \u00a713).\n\nVisual prominence, NOT semantic importance.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "SubjectProminence",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One directed shooting interaction. May belong to a Story (02 \u00a714).\n\nIf `story_id` is absent, this is a standalone Create Now session.\nHolds the scene/directing/capture state DIRECT needs.",
  "properties": {
    "capture_asset_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Capture Asset Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "creative_intent": {
      "$ref": "#/$defs/CreativeIntentContract"
    },
    "director_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/DirectorState"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Mutable DIRECT loop state (05 \u00a78). Plan stays stable; this changes."
    },
    "entry_point": {
      "$ref": "#/$defs/CaptureEntryPoint"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "scene_understanding": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneUnderstandingContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_concept": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoryConceptContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "story_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Story Id"
    },
    "story_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoryPlanContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "entry_point",
    "creative_intent"
  ],
  "title": "CaptureSession",
  "type": "object"
}
